<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>LineFix</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Step 1: Keep "Find mode" ON. A bright red strip appears. Move it with the buttons below until it sits exactly on the line.
Step 2: Turn "Find mode" OFF and tune the colors until the line blends in.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Enabled</string>
			<key>key</key><string>enabled</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.yasin.linefix</string>
			<key>PostNotification</key><string>com.yasin.linefix/changed</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Find mode (red strip)</string>
			<key>key</key><string>findMode</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.yasin.linefix</string>
			<key>PostNotification</key><string>com.yasin.linefix/changed</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Position (pixels from the left, 0–1241)</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>X position</string>
			<key>key</key><string>x</string>
			<key>default</key><string>1200</string>
			<key>keyboard</key><string>numbers</string>
			<key>isNumeric</key><true/>
			<key>defaults</key><string>com.yasin.linefix</string>
			<key>PostNotification</key><string>com.yasin.linefix/changed</string>
		</dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>◀︎◀︎ Move left 10 px</string><key>action</key><string>xMinus10</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>◀︎ Move left 1 px</string><key>action</key><string>xMinus1</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Move right 1 px ▶︎</string><key>action</key><string>xPlus1</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Move right 10 px ▶︎▶︎</string><key>action</key><string>xPlus10</string></dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Width (pixels)</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>Width</string>
			<key>key</key><string>width</string>
			<key>default</key><string>1</string>
			<key>keyboard</key><string>numbers</string>
			<key>isNumeric</key><true/>
			<key>defaults</key><string>com.yasin.linefix</string>
			<key>PostNotification</key><string>com.yasin.linefix/changed</string>
		</dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Thinner −1 px</string><key>action</key><string>widthMinus</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Wider +1 px</string><key>action</key><string>widthPlus</string></dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Strip color (used when Find mode is OFF)</string>
			<key>footerText</key><string>The broken column's green is stuck at one level. Raise Red and Blue together until the line looks neutral grey instead of green (on dark) or pink (on white). Green only matters if width is more than 1 px.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>Red</string>
			<key>key</key><string>red</string>
			<key>default</key><real>128</real>
			<key>min</key><real>0</real>
			<key>max</key><real>255</real>
			<key>showValue</key><true/>
			<key>isSegmented</key><true/>
			<key>segmentCount</key><integer>255</integer>
			<key>defaults</key><string>com.yasin.linefix</string>
			<key>PostNotification</key><string>com.yasin.linefix/changed</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>Green</string>
			<key>key</key><string>green</string>
			<key>default</key><real>128</real>
			<key>min</key><real>0</real>
			<key>max</key><real>255</real>
			<key>showValue</key><true/>
			<key>isSegmented</key><true/>
			<key>segmentCount</key><integer>255</integer>
			<key>defaults</key><string>com.yasin.linefix</string>
			<key>PostNotification</key><string>com.yasin.linefix/changed</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>Blue</string>
			<key>key</key><string>blue</string>
			<key>default</key><real>128</real>
			<key>min</key><real>0</real>
			<key>max</key><real>255</real>
			<key>showValue</key><true/>
			<key>isSegmented</key><true/>
			<key>segmentCount</key><integer>255</integer>
			<key>defaults</key><string>com.yasin.linefix</string>
			<key>PostNotification</key><string>com.yasin.linefix/changed</string>
		</dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Reset colors to 128</string><key>action</key><string>resetColors</string></dict>
	</array>
</dict>
</plist>
